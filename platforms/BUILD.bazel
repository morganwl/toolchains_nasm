load(":utils.bzl", "platform_and_settings")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

platform_and_settings(
    name = "elf",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:i386",
    ],
)

platform_and_settings(
    name = "elf64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform_and_settings(
    name = "macho64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

platform_and_settings(
    name = "win64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)
